{
  "name": "n8n-nodes-seedance2",
  "version": "1.5.0",
  "description": "对接火山方舟官方 API，使用 Seedance 2.5/2.0 模型生成视频，或使用 Seedream 5.0 模型生成图像。",
  "license": "MIT",
  "homepage": "https://github.com/kkuxb/n8n-nodes-seedance2",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "seedance",
    "seedance2.5",
    "seedance2.0",
    "seedream5.0",
    "即梦",
    "火山引擎",
    "AI视频生成",
    "AI图像生成"
  ],
  "author": {
    "name": "kkuxb"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkuxb/n8n-nodes-seedance2.git"
  },
  "bugs": {
    "url": "https://github.com/kkuxb/n8n-nodes-seedance2/issues"
  },
  "packageManager": "npm@11.12.1",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "main": "dist/nodes/Seedance/Seedance.node.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "n8n-node build",
    "dev": "node scripts/dev.mjs",
    "dev:setup": "node scripts/setup-dev-runtime.mjs",
    "lint": "n8n-node lint",
    "test": "npm run build && node --test test/*.test.ts",
    "lint:fix": "n8n-node lint --fix"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/SeedanceApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Seedance/Seedance.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.23.1",
    "@types/node": "^24.0.0",
    "eslint": "9.29.0",
    "n8n-workflow": "^2.13.1",
    "typescript": "^5.8.3"
  }
}
